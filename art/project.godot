; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="桜の踏切 · 春日街角"
run/main_scene="res://street/street.tscn"
config/use_custom_user_dir=true
config/custom_user_dir_name="SakuraCrossing"
config/features=PackedStringArray("4.7", "Forward Plus")
run/max_fps=60

[display]

window/size/viewport_width=1704
window/size/viewport_height=960
window/size/window_width_override=1065
window/size/window_height_override=600
window/stretch/mode="viewport"

[rendering]

anti_aliasing/quality/msaa_3d=2
