+## 4.7 compatibility: owned storage buffers instead of borrowing 4.8 mesh RIDs.
+func bridge_buffer(at: int, field: String) -> RID:
+	var key: String = str(at) + ":" + field
+	if bridge_buffers.has(key):
+		return bridge_buffers[key]
+	var raw: Dictionary = RenderingServer.mesh_get_surface(mesh_rid, at)
+	var bytes: PackedByteArray = raw[field]
+	bytes.resize(maxi(4, ceili(bytes.size() / 4.0) * 4))
+	var buffer: RID = RenderingServer.get_rendering_device().storage_buffer_create(bytes.size(), bytes)
+	bridge_buffers[key] = buffer
+	return buffer
+
+
+func release_bridge() -> void:
+	var device: RenderingDevice = RenderingServer.get_rendering_device()
+	for buffer: RID in bridge_buffers.values():
+		if buffer.is_valid():
+			device.free_rid(buffer)
+	bridge_buffers.clear()
