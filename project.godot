; Engine configuration file. Source-controlled; local caches live in .godot/.
config_version=5

[application]
config/name="风栖小筑 · Week 01"
config/version="0.1.0-w01"
run/main_scene="res://app/app_root.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://assets/icon.svg"

[display]
window/size/viewport_width=1280
window/size/viewport_height=800
window/size/window_width_override=1280
window/size/window_height_override=800
window/stretch/mode="canvas_items"

[rendering]
renderer/rendering_method="forward_plus"
renderer/rendering_method.mobile="mobile"
textures/default_filters/use_nearest_mipmap_filter=false
textures/vram_compression/import_etc2_astc=true
textures/vram_compression/import_s3tc_bptc=true
environment/defaults/default_clear_color=Color(0.72, 0.8, 0.76, 1)

[debug]
gdscript/warnings/untyped_declaration=1

[input]
camera_orbit={"deadzone":0.5,"events":[Object(InputEventMouseButton,"button_index":2)]}
camera_pan={"deadzone":0.5,"events":[Object(InputEventMouseButton,"button_index":3)]}
cancel_edit={"deadzone":0.5,"events":[Object(InputEventKey,"physical_keycode":4194305)]}
undo_edit={"deadzone":0.5,"events":[Object(InputEventKey,"physical_keycode":90,"command_or_control_autoremap":true)]}
redo_edit={"deadzone":0.5,"events":[Object(InputEventKey,"physical_keycode":90,"shift_pressed":true,"command_or_control_autoremap":true)]}
save_work={"deadzone":0.5,"events":[Object(InputEventKey,"physical_keycode":83,"command_or_control_autoremap":true)]}
load_work={"deadzone":0.5,"events":[Object(InputEventKey,"physical_keycode":79,"command_or_control_autoremap":true)]}
reset_camera={"deadzone":0.5,"events":[Object(InputEventKey,"physical_keycode":70)]}
